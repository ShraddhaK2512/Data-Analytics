      </column>
      <column caption='Alone or Someone' datatype='string' name='[Calculation_1897141367406911490]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parch] = 0 THEN &apos;Traveling Alone&apos;&#13;&#10;ELSE &apos;Traveling with Someone&apos;&#13;&#10;END' />
