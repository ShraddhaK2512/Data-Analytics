      <column caption='people survival' datatype='string' name='[Calculation_1396397383794491394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Survived]=0 THEN &quot;Not Survived&quot;&#13;&#10;Else &quot;Survived&quot;&#13;&#10;END' />
