      <column caption='Age Grp' datatype='string' name='[Calculation_1897141367403712512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &gt;= 1 AND [Age] &lt;= 15 THEN &apos;Child&apos;&#13;&#10;ELSEIF [Age] &gt;= 16 AND [Age] &lt;= 50 THEN &apos;Young&apos;&#13;&#10;ELSE &apos;Old&apos;&#13;&#10;END' />
      </column>
      <column caption='Pclass Grp' datatype='string' name='[Calculation_1897141367404138497]' role='dimension' type='nominal'>
